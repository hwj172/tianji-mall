# docker/.env.example — 复制为 .env 并填入真实值。不要提交 .env！
# 供 docker-compose.yml（中间件）与 docker-compose.apps.yml（服务）共同读取。

# ── 必需密钥（无默认值，缺失时对应服务启动失败）──
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me
DEEPSEEK_API_KEY=sk-xxxx
SILICONFLOW_API_KEY=sk-xxxx
ALIPAY_PRIVATE_KEY=change-me

# ── 中间件密码（docker-compose.yml 读取）──
MYSQL_ROOT_PASSWORD=change-me
# Nacos 鉴权 token：必须 base64 且解码后不短于 32 字节，否则 Nacos 起不来。
# 下面是 Nacos 官方文档的示例值，格式合法可直接用。
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-please
SENTINEL_USERNAME=sentinel
SENTINEL_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ── 可选覆盖（两个 compose 文件都已有默认值，一般无需设置）──
# MYSQL_USER=root
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=nacos
# ROCKETMQ_ACCESS_KEY=tianji-mall
# ROCKETMQ_SECRET_KEY=tianji-mall-secret
# 注：支付宝 appId/公钥/网关/回调 URL 为沙盒公开数据，已硬编码在 apps.yml，不走 .env
