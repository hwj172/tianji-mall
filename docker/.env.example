# docker/.env.example — 复制为 .env 并填入真实值。不要提交 .env！
# 与 docker-compose.apps.yml 的 ${VAR} 对应

# 必需密钥（无默认值，缺失时对应服务启动失败）：
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me
DEEPSEEK_API_KEY=sk-xxxx
SILICONFLOW_API_KEY=sk-xxxx
ALIPAY_PRIVATE_KEY=change-me

# 可选覆盖（apps.yml 已有默认值，一般无需设置）：
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=nacos
# REDIS_PASSWORD=redis123
# ROCKETMQ_ACCESS_KEY=tianji-mall
# ROCKETMQ_SECRET_KEY=tianji-mall-secret
# 注：支付宝 appId/公钥/网关/回调 URL 为沙盒公开数据，已硬编码在 apps.yml，不走 .env
